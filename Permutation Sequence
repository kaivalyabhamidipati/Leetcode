import math

class Solution:
    # tc : o(n^2) , sc : o(n)
    def rec(self, nums, fac, k, ans): #o(n)
        if len(nums) == 1:
            ans.append(str(nums[0]))
            return

        nxt_fac = fac // len(nums)

        dig = (k - 1) // nxt_fac
        ans.append(str(nums[dig]))
        nums.pop(dig) #o(n) 

        k = k % nxt_fac
        if k == 0: k = nxt_fac

        self.rec(nums, nxt_fac, k, ans)

    def getPermutation(self, n: int, k: int) -> str:

        ans = [] # o(n) space 
        nums = [i for i in range(1, n + 1)]
        fac = math.factorial(n)

        self.rec(nums, fac, k, ans)

        return "".join(ans)
        
