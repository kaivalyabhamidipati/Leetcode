class Solution:
    def setZeroes(self, mat: List[List[int]]) -> None:
        arr = []
        m, n = len(mat), len(mat[0])

        for i in range(m):
            for j in range(n):
                if mat[i][j] == 0:
                    arr.append((i, j))

        for r, c in arr:
            for j in range(n):
                mat[r][j] = 0
            for i in range(m):
                mat[i][c] = 0
        
       
        
